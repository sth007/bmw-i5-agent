# Optional OpenAI API key for flows or services that call OpenAI models.
# Leave this commented out if the current setup does not use OpenAI directly.
#OPENAI_API_KEY=your_api_key_here

# Optional Google Places API key for any dealer-enrichment or location lookup logic.
# Leave this commented out if Google Places is not part of your workflow.
#GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Main application database connection string.
# This database is used by the running API and n8n-backed application flows.
# In Docker Compose, the hostname is usually the Postgres service name: `postgres`.
#DATABASE_URL=postgresql+psycopg://bmw_agent:change-me@postgres:5432/bmw_agent_app

# Dedicated test database connection string.
# Tests must use a separate database and must not run against the main application database.
# Keeping test data isolated prevents accidental corruption of development data.
#TEST_DATABASE_URL=postgresql+psycopg://bmw_agent:change-me@postgres:5432/bmw_agent_test

# Name of the PostgreSQL database container should create at startup.
# This is the initial database name managed by the Postgres service itself.
POSTGRES_DB=bmw_agent

# PostgreSQL username used by the database container and connecting services.
POSTGRES_USER=bmw_agent

# PostgreSQL password used by the database container and connecting services.
# Replace this with a strong secret before using the stack outside local development.
POSTGRES_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Encryption key used by n8n to protect stored credentials and other sensitive values.
# This value must remain stable for an existing n8n instance, otherwise stored credentials may become unreadable.
N8N_ENCRYPTION_KEY=sgi/xxxxxxxxxxxxxxx

# Public hostname under which n8n is accessed.
# For local development this is usually `localhost`.
N8N_HOST=localhost

# Port on which n8n is exposed.
N8N_PORT=5678

# Protocol used to access n8n from the browser or external callbacks.
# Use `http` for local development and usually `https` in production.
N8N_PROTOCOL=http

# Controls whether n8n marks cookies as secure-only.
# `false` is usually required for plain HTTP local development.
# In production behind HTTPS, this should normally be `true`.
N8N_SECURE_COOKIE=false

# Base timezone used by containers and application processes.
# This affects logs, timestamps, and time-based scheduling behavior.
TZ=Europe/Berlin

# n8n-specific timezone used for schedule triggers and workflow time interpretation.
# In most cases this should match `TZ` to avoid confusion.
GENERIC_TIMEZONE=Europe/Berlin

# Security token required by the admin test reset endpoints.
# This protects destructive reset actions in development or test environments.
TEST_RESET_TOKEN=xxxxxxxxxxxxxxxxx

# Application runtime environment.
# Supported values in this project are typically:
# - development: local work and debugging
# - test: automated tests and isolated test execution
# - production: deployed runtime with stricter safety expectations
APP_ENV=development

# Enables the admin reset endpoints that clear campaign or application state for testing.
# This should only be `true` in development or test environments.
ALLOW_TEST_RESET=true
